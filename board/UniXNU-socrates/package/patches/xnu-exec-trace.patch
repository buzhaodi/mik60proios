+/*
+ * EXEC TRACE (socrates bring-up): this board has no working kernel-side
+ * serial console and the panic renderer clears the frame buffer, so the
+ * exec -v scroll - including the "load code signature error" printf below -
+ * is unreadable on the device. The panic screen prints this one word after
+ * the panic message:
+ *   byte 0 STAGE bitmask, bit n-1 set when stage n ran:
+ *                 1 load_machfile entered, 2 parse_machfile entered,
+ *                 3 LC_CODE_SIGNATURE dispatch reached,
+ *                 4 load_code_signature failed (byte 1 = its return code),
+ *                 5 code signature loaded, 6 parse_machfile returned
+ *                 (byte 2 = its load_return_t), 7 load_machfile returned to
+ *                 exec (byte 3 = its load_return_t);
+ *   byte 4 REJECT SITE, 0 = none stamped:
+ *                 1 header+sizeofcmds sanity check (parse entry),
+ *                 2 short read of the command area (resid != 0),
+ *                 3 no room for a minimal load command,
+ *                 4 load-command prevalidation (cmdsize overflow/straddle),
+ *                 5 load_segment returned an error (pass 2),
+ *                 6 header-segment rule after a successful load_segment,
+ *                 7 pass 3 found no segment mapping the header,
+ *                 8 segment cmdsize smaller than its struct,
+ *                 9 LC_SEGMENT(_64) for the wrong ABI;
+ *   byte 7 0xE7 canary, proving on the panic screen that the read worked and
+ *                 keeping the variable in the file-backed __DATA segment the
+ *                 renderer's symbol validation requires.
+ * The exec path of a boot is single-threaded (init), so the stamps race with
+ * nothing. The bitmask keeps the whole history: e.g. 0x63 says parse entered
+ * and returned without ever reaching the signature load.
+ */
+volatile unsigned long g_exec_trace = 0xE700000000000000ULL;
+#define G_EXEC_TRACE_SITE(n) g_exec_trace = (g_exec_trace & ~0xFF00000000ULL) | ((unsigned long)(n) << 32)
+
+/*
+ * The user-mode fault context (socrates, 2026-11-05). The PID 1 SIGBUS death
+ * had NO EL0 abort in the hardware path, so the record has two layers:
+ *   slot 0 kind bitmask + canary top byte: bit 0 set by osfmk/arm64/sleh.c
+ *                 (handle_user_abort: a genuine EL0 abort reached triage),
+ *                 bit 1 set by bsd/uxkern/ux_exception.c (handle_ux_exception:
+ *                 the Mach-exception-to-signal funnel ran - this fires even
+ *                 when the hardware abort was never an EL0 one);
+ *   slots 1-4 the EL0 abort: faulting pc, address, ESR, stack pointer;
+ *   slots 5-7 the signal funnel: code (kern_return), subcode (the faulting
+ *                 address for EXC_BAD_ACCESS), exception<<32 | delivered
+ *                 signal number.
+ * The panic renderer prints all of it after the panic message; the cleared
+ * frame buffer leaves no other trace of what killed init. Top-byte canary
+ * and file-backed __DATA placement, same reasoning as g_exec_trace.
+ */
+volatile unsigned long g_exec_fault[8] = {0xE700000000000000ULL, 0, 0, 0, 0, 0, 0, 0};
