diff --git a/DarwinBootPkg/Driver/DarwinBoot.c b/DarwinBootPkg/Driver/DarwinBoot.c
index 3b6cafc..5130a82 100644
--- a/DarwinBootPkg/Driver/DarwinBoot.c
+++ b/DarwinBootPkg/Driver/DarwinBoot.c
@@ -490,9 +490,19 @@ DiagDraw (CONST CHAR16 *Text, UINTN Row)
   }
 }
 
+// The one conventional run the 256 MiB window can land in below 4 GiB spans an
+// unknown-owner gap (MemoryMapLib "DRAM gap 0xc7cc0000": kept allocatable only
+// because the stock firmware also allocates from it), so a first-fit window
+// rolls across it with every pool-layout change and every boot - and a boot
+// whose window reaches a protected page dies between the green and blue bars
+// (first-boot evidence 2026-11-05: dc civac over the window raises an
+// asynchronous external abort). Prefer a fixed placement in the gap-free
+// conventional bank above 4 GiB; the map scan below stays as the fallback.
+#define WINDOW_PREFERRED_BASE  0x880000000ULL   // "DRAM bank 1 low": 947 MiB, no gaps inside
+
 STATIC
 EFI_STATUS
-AllocateWindow (KERNEL *Kernel, UINT64 WindowSize, EFI_PHYSICAL_ADDRESS *Address)
+AllocateWindow (KERNEL *Kernel, UINT64 WindowSize, EFI_PHYSICAL_ADDRESS *Address, BOOLEAN *FromPreferred)
 {
   EFI_MEMORY_DESCRIPTOR *Map;
   EFI_MEMORY_DESCRIPTOR *Descriptor;
@@ -509,6 +519,17 @@ AllocateWindow (KERNEL *Kernel, UINT64 WindowSize, EFI_PHYSICAL_ADDRESS *Address
   UINT64                RunBytes;
 
   *Address = 0;
+  *FromPreferred = FALSE;
+  if (WINDOW_PREFERRED_BASE != 0) {
+    Candidate = ALIGN_VALUE (WINDOW_PREFERRED_BASE, BLOCK_SIZE) + (Kernel->Base & (BLOCK_SIZE - 1));
+    Status = gBS->AllocatePages (AllocateAddress, EfiLoaderCode, EFI_SIZE_TO_PAGES (WindowSize), &Candidate);
+    if (!EFI_ERROR (Status)) {
+      *Address = Candidate;
+      *FromPreferred = TRUE;
+      return EFI_SUCCESS;
+    }
+    Print (L"DARWINBOOT: fixed window 0x%lx refused: %r; scanning\n", (UINT64)WINDOW_PREFERRED_BASE, Status);
+  }
   Map = NULL;
   Capacity = 0;
   BestStart = 0;
@@ -597,6 +618,7 @@ Boot (
   UINTN                           Stride;
   UINT32                          Version;
   UINTN                           Attempt;
+  BOOLEAN                         FromPreferred;
   CHAR8                           CommandLine[1024];
   UINT64                          Video[6];
 
@@ -719,7 +741,8 @@ Boot (
   }
   Status = ReadBootVideo (Video);
   if (EFI_ERROR (Status)) { goto Fail; }
-  Status = AllocateWindow (&Kernel, WindowSize, &Address);
+  FromPreferred = FALSE;
+  Status = AllocateWindow (&Kernel, WindowSize, &Address, &FromPreferred);
   if (EFI_ERROR (Status)) { goto Fail; }
   ArgsAddress = ALIGN_VALUE (Address + Kernel.End - Kernel.Base, SIZE_16KB);
   TreeAddress = ArgsAddress + EFI_PAGE_SIZE;
@@ -804,10 +827,26 @@ Boot (
           ReadUnaligned32 ((CONST UINT32 *)(UINTN)(Address + Kernel.Entry - Kernel.Base + 4)),
           ReadUnaligned32 ((CONST UINT32 *)(UINTN)(Address + Kernel.Entry - Kernel.Base + 8)),
           ReadUnaligned32 ((CONST UINT32 *)(UINTN)(Address + Kernel.Entry - Kernel.Base + 12))));
+  DEBUG ((DEBUG_ERROR, "window   0x%lx + 0x%lx %a\n", (UINT64)Address, (UINT64)WindowSize,
+          FromPreferred ? "fixed" : "scan"));
   DEBUG ((DEBUG_ERROR, "CurrentEL %lu  SCTLR_EL1 0x%lx  TCR_EL1 0x%lx\n", DarwinCurrentEl () >> 2, READ_SYSREG (sctlr_el1), READ_SYSREG (tcr_el1)));
   DEBUG ((DEBUG_ERROR, "ID_AA64MMFR0_EL1 0x%lx  (PARange %lu, 4 KiB granule %a)\n", READ_SYSREG (id_aa64mmfr0_el1),
           READ_SYSREG (id_aa64mmfr0_el1) & 0xF, (((READ_SYSREG (id_aa64mmfr0_el1) >> 28) & 0xF) == 0xF) ? "NOT supported" : "supported"));
   DEBUG ((DEBUG_ERROR, "ID_AA64PFR0_EL1  0x%lx\n", READ_SYSREG (id_aa64pfr0_el1)));
+  //
+  // socrates (2026-11-06, removed): the TZ_SECURE_WDOG_DISABLE SMC
+  // (0x02000107) that used to fire here killed the boot on dirty TZ state.
+  // The same FD booted fine while the phone was clean, but after the
+  // deliberate panic cycles of the fork-diagnostics rounds every boot reset
+  // with this hand-off page ending exactly at the ID_AA64PFR0 line - the
+  // next statement was this SMC, and the TZ return-code line that follows
+  // never once appeared. Full Android boots (the classic ABL/PMIC pollution
+  // cure) did not help, which fits TZ state surviving those resets. The
+  // watchdog the call targeted never fired again anyway: the v1.2 frozen
+  // console sat five minutes with no reset. If the long-run reboot returns,
+  // disable the watchdog kernel-side instead (APSS WDT registers, mapped
+  // early in pexpert) rather than from the loader.
+  //
   DEBUG ((DEBUG_ERROR, "\nExiting boot services. A green bar across the top\nmarks the loader handoff before the kernel branch.\n"));
   for (Attempt = 0; Attempt < 3; Attempt++) {
     MapSize = Capacity;
diff --git a/DarwinBootPkg/Driver/Entry.S b/DarwinBootPkg/Driver/Entry.S
index a7a55c2..0cacbef 100644
--- a/DarwinBootPkg/Driver/Entry.S
+++ b/DarwinBootPkg/Driver/Entry.S
@@ -7,11 +7,19 @@ ASM_FUNC(DarwinCurrentEl)
 
 // x0=boot_args PA, x1=entry PA, x2=owned PA, x3=owned size, x4=frame buffer
 // PA (0 for none), x5=its size in bytes. EL1 only.
+//
+// Stage telemetry (diagnostic build): band 0 green = handoff entered, band 2
+// yellow = window flush starting, band 3 cyan = flush done (before the I-cache
+// invalidate and MMU off), band 4 white = about to branch to the kernel.
 ASM_FUNC(DarwinEnter)
   msr daifset, #15
+  mov x12, xzr
+  mov x13, xzr
   // Paint the top 1/16 of the framebuffer green (BGRA 0xFF00FF00)
   // before cache maintenance, MMU shutdown and the branch to the kernel.
   cbz x4, 2f
+  mov x12, x4
+  mov x13, x5
   lsr x9, x5, #4
   bic x9, x9, #7
   mov w10, #0xFF00
@@ -23,6 +31,19 @@ ASM_FUNC(DarwinEnter)
   b.hi 3b
   dsb sy
 2:
+  cbz x12, 5f
+  // band 2 yellow: the dc civac walk over the window is about to start
+  lsr x9, x13, #4
+  bic x9, x9, #7
+  mov w10, #0xFFFF
+  movk w10, #0xFF00, lsl #16
+  add x11, x12, x9, lsl #1
+4:
+  stp w10, w10, [x11], #8
+  subs x9, x9, #8
+  b.hi 4b
+  dsb sy
+5:
   add x5, x2, x3
   mrs x6, ctr_el0
   ubfx x6, x6, #16, #4
@@ -37,6 +58,20 @@ ASM_FUNC(DarwinEnter)
   cmp x4, x5
   b.lo 1b
   dsb sy
+  cbz x12, 6f
+  // band 3 cyan: window flush complete, I-cache invalidate / MMU off next
+  lsr x9, x13, #4
+  bic x9, x9, #7
+  mov w10, #0xFF00
+  movk w10, #0xFFFF, lsl #16
+  add x11, x12, x9
+  add x11, x11, x9, lsl #1
+7:
+  stp w10, w10, [x11], #8
+  subs x9, x9, #8
+  b.hi 7b
+  dsb sy
+6:
   ic iallu
   dsb sy
   isb
@@ -49,4 +84,17 @@ ASM_FUNC(DarwinEnter)
   tlbi vmalle1
   dsb sy
   isb
+  cbz x12, 8f
+  // band 4 white: branching to the kernel entry now
+  lsr x9, x13, #4
+  bic x9, x9, #7
+  mov w10, #0xFFFF
+  movk w10, #0xFFFF, lsl #16
+  add x11, x12, x9, lsl #2
+9:
+  stp w10, w10, [x11], #8
+  subs x9, x9, #8
+  b.hi 9b
+  dsb sy
+8:
   br x1
